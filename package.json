{
  "name": "dsh-result-comments",
  "version": "1.0.1",
  "type": "module",
  "description": "Select text in an AI reply, mark it 👍 or with a 🤔 comment, and turn each comment into a tag in the composer that is sent with the user's own message.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "review",
    "comments",
    "composer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Liam-liyaming/dsh-result-comments"
  },
  "homepage": "https://github.com/Liam-liyaming/dsh-result-comments#readme",
  "bugs": {
    "url": "https://github.com/Liam-liyaming/dsh-result-comments/issues"
  }
}
